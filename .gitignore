# Platform-binary packages — `galeforcecss` CLI binary + `galeforcecss.exe`
# get staged into these dirs by CI (release.yml). They MUST NOT be
# committed; the README + package.json stay in git, the binaries don't.
packages/galeforcecss-darwin-arm64/galeforcecss
packages/galeforcecss-darwin-x64/galeforcecss
packages/galeforcecss-linux-arm64-gnu/galeforcecss
packages/galeforcecss-linux-x64-gnu/galeforcecss
packages/galeforcecss-win32-x64-msvc/galeforcecss.exe


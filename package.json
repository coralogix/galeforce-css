{
  "name": "galeforcecss-monorepo",
  "version": "0.0.0",
  "private": true,
  "description": "Rust-powered, Tailwind CSS v3-compatible compiler with Vite integration.",
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": ">=18.18"
  },
  "packageManager": "pnpm@10.33.4",
  "scripts": {
    "build": "pnpm -r --filter './packages/*' run build",
    "test": "pnpm -r --filter './packages/*' run test",
    "typecheck": "pnpm -r --filter './packages/*' run typecheck",
    "oracle:version": "tsx scripts/verify-tailwind-reference.ts",
    "license:check": "hawkeye check",
    "license:fix": "hawkeye format",
    "conformance:test": "pnpm --filter @coralogix/galeforcecss-conformance run test",
    "conformance:update": "pnpm --filter @coralogix/galeforcecss-conformance run update",
    "fixtures:rebuild": "tsx scripts/rebuild-fixture-snapshots.ts",
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs",
    "docs:preview": "vitepress preview docs"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.47",
    "tailwindcss": "3.4.19",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vite": "^8.0.12",
    "vitepress": "^2.0.0-alpha.17",
    "vitest": "^4.1.5"
  },
  "dependencies": {
    "@tailwindcss/forms": "^0.5.11"
  }
}

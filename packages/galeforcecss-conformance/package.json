{
  "name": "@coralogix/galeforcecss-conformance",
  "version": "0.0.0",
  "private": true,
  "description": "Conformance harness: oracle (Tailwind 3) vs. GaleforceCSS.",
  "license": "Apache-2.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "galeforce-conformance": "./dist/cli.js"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "update": "vitest run --update",
    "smoke": "tsx src/smoke.ts",
    "bench": "tsx src/bench.ts"
  },
  "dependencies": {
    "@coralogix/galeforcecss-config-loader": "workspace:*",
    "@coralogix/galeforcecss-oracle": "workspace:*",
    "@coralogix/galeforcecss": "workspace:*",
    "postcss": "^8.4.47"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "typescript": "^5.6.0",
    "vitest": "^4.1.5"
  }
}

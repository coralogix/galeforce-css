{
  "name": "@cx/galeforcecss",
  "version": "0.1.7",
  "description": "Rust-powered Tailwind CSS v3-compatible compiler — drop-in replacement for Tailwind v3.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/coralogix/internal-galeforce-css.git",
    "directory": "packages/galeforcecss"
  },
  "homepage": "https://github.com/coralogix/internal-galeforce-css",
  "keywords": [
    "tailwind",
    "tailwindcss",
    "css",
    "rust",
    "compiler",
    "vite"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@cx/galeforcecss-config-loader": "workspace:*"
  },
  "optionalDependencies": {
    "@cx/galeforcecss-darwin-arm64": "workspace:*",
    "@cx/galeforcecss-darwin-x64": "workspace:*",
    "@cx/galeforcecss-linux-x64-gnu": "workspace:*",
    "@cx/galeforcecss-linux-arm64-gnu": "workspace:*",
    "@cx/galeforcecss-win32-x64-msvc": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "typescript": "^5.6.0",
    "vitest": "^4.1.5"
  },
  "publishConfig": {
    "registry": "https://cgx.jfrog.io/artifactory/api/npm/internal.npm.coralogix.net/"
  }
}

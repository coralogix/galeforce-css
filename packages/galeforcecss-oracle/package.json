{
  "name": "@coralogix/galeforcecss-oracle",
  "version": "0.0.0",
  "private": true,
  "description": "Wraps tailwindcss@3.4.19 as the conformance oracle for GaleforceCSS.",
  "license": "Apache-2.0",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "postcss": "^8.4.47",
    "tailwindcss": "3.4.19"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "typescript": "^5.6.0",
    "vitest": "^4.1.5"
  }
}
